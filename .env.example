# Presyn Environment Configuration Template
# Copy this file to .env and adjust values for your local deployment.
# NEVER commit the actual .env file or real production secrets to source control.

# ==============================================================================
# SERVER AND APPLICATION
# ==============================================================================
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ==============================================================================
# SECURITY AND AUTHENTICATION
# ==============================================================================
# Generate a secure random string for production deployments
SECRET_KEY=change-this-insecure-key-before-production-deployment-min32chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ==============================================================================
# DATABASE
# ==============================================================================
DATABASE_URL=sqlite:///./data/presyn.db

# ==============================================================================
# CAMERA INGESTION AND PROCESSING
# ==============================================================================
# Target processing frame rate for CPU inference per camera
PROCESSING_FPS=5
FRAME_WIDTH=1280
FRAME_HEIGHT=720
CAMERA_RECONNECT_INTERVAL_SECONDS=5
CAMERA_MAX_RECONNECT_ATTEMPTS=10

# ==============================================================================
# FACE DETECTION AND RECOGNITION THRESHOLDS (PRE-CALIBRATION BASELINE)
# ==============================================================================
# Quality gates (faces failing these criteria are rejected from recognition)
FACE_MIN_SIZE_PX=48
FACE_BLUR_THRESHOLD=60.0
FACE_BRIGHTNESS_MIN=40.0
FACE_BRIGHTNESS_MAX=220.0

# Similarity and matching thresholds
FACE_SIMILARITY_THRESHOLD=0.65
FACE_MARGIN_THRESHOLD=0.10
FACE_MAX_TEMPLATES_PER_EMPLOYEE=50

# Multi-frame verification window
VERIFICATION_WINDOW_SECONDS=2.0
VERIFICATION_MIN_VOTES=5

# Incremental template learning threshold (conservative)
INCREMENTAL_LEARNING_THRESHOLD=0.82
INCREMENTAL_LEARNING_MARGIN=0.15

# ==============================================================================
# TRACKING AND PRESENCE CONFIGURATION
# ==============================================================================
TRACK_LOST_TIMEOUT_SECONDS=3.0
PRESENCE_TEMPORARILY_LOST_SECONDS=15.0

# ==============================================================================
# OPTIONAL MODULE FEATURE FLAGS (ALL DEFAULT OFF)
# ==============================================================================
# Optional models lazy-load only when enabled and must not crash system startup
ENABLE_MASK_DETECTION=false
ENABLE_LIVENESS_CHECK=false
ENABLE_EXPRESSION_TRENDS=false

# ==============================================================================
# VISITOR AND SECURITY POLICY
# ==============================================================================
DEFAULT_VISITOR_MODE=false
UNKNOWN_ALERT_COOLDOWN_SECONDS=60

# ==============================================================================
# DATA RETENTION AND PRIVACY POLICIES (DAYS)
# ==============================================================================
EVENT_RETENTION_DAYS=90
AUDIT_LOG_RETENTION_DAYS=365
SNAPSHOT_RETENTION_DAYS=7
